# Baked into the bundle at build time by `vite build`.
#
# This lives in git on purpose. It is not a secret — it ends up in the
# client JS either way — and keeping it here means a production build is
# reproducible from the repo instead of depending on a dashboard field
# being set correctly in the right environment.
#
# NOTE: a VITE_API_URL set in Vercel's project settings OVERRIDES this file.
# Keep exactly one source of truth: if you set it in the dashboard, delete
# it there, or make sure both agree.
VITE_API_URL=https://groundwork-api-92jh.onrender.com
