# Featherless.ai — OpenAI-compatible endpoint
FEATHERLESS_API_KEY=your_key_here
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Small/cheap model for occupation-title matching (Stage 0)
FEATHERLESS_SMALL_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# Strong model for roadmap synthesis (Stage 4)
FEATHERLESS_STRONG_MODEL=moonshotai/Kimi-K3

# O*NET Web Services — register free at https://services.onetcenter.org/
ONET_USERNAME=your_onet_username
ONET_PASSWORD=your_onet_password

# CORS — comma-separated exact origins allowed to call this API.
# Defaults to the local Vite dev server if unset. On Render, set this to your
# Vercel production URL. Vercel *.vercel.app preview deploys are already
# allowed by regex in app/main.py.
ALLOWED_ORIGINS=http://localhost:5173
